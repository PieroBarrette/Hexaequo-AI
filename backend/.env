# Hexaequo Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3001

# ============================================
# DATABASE (PostgreSQL)
# ============================================
# Local development
DATABASE_URL=postgresql://postgres:password@localhost:5432/hexaequo

# Production (Render) - Will be set automatically by Render when you create a PostgreSQL database
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ============================================
# SECURITY
# ============================================
# JWT Secret - CHANGE THIS IN PRODUCTION!
JWT_SECRET=hexaequo-jwt-secret-change-this-in-production-2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing rounds (higher = more secure but slower)
BCRYPT_ROUNDS=10

# Admin panel password - CHANGE THIS IN PRODUCTION!
DEBUG_PASSWORD=hexadmin2026

# ============================================
# EMAIL (SMTP) - Optional for email verification
# ============================================
# Leave empty to disable email verification
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Hexaequo <noreply@hexaequo.com>

# ============================================
# FRONTEND URL (for CORS and email links)
# ============================================
FRONTEND_URL=http://localhost:8080

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
