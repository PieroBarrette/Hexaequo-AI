{
    "name": "hexaequo-server",
    "version": "1.0.0",
    "description": "Hexaequo REST API Backend",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "node tests/engine.test.js && node tests/onlineGame.test.js",
        "test:engine": "node tests/engine.test.js",
        "test:online": "node tests/onlineGame.test.js",
        "test:jest": "jest",
        "test:integration": "jest --testPathPattern=tests/integration",
        "db:init": "node scripts/initDb.js",
        "db:reset": "node scripts/resetDb.js",
        "db:cleanup": "node scripts/cleanupDb.js",
        "db:migrate": "node scripts/migration_phase0.js",
        "test:elo": "node tests/eloService.test.js"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "nodemailer": "^6.9.8",
        "pg": "^8.11.3",
        "socket.io": "^4.8.1",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "socket.io-client": "^4.8.3",
        "supertest": "^6.3.3"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "keywords": [
        "hexaequo",
        "game",
        "api",
        "backend"
    ],
    "license": "MIT"
}
