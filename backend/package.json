{
    "name": "hexaequo-server",
    "version": "1.0.0",
    "description": "Hexaequo REST API Backend",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "node tests/engine.test.js && node tests/judge.test.js && node tests/onlineGame.test.js && node tests/push.test.js && node tests/streak.test.js && node tests/accountFlows.test.js && node tests/pages.test.js",
        "test:engine": "node tests/engine.test.js",
        "test:judge": "node tests/judge.test.js",
        "test:online": "node tests/onlineGame.test.js",
        "test:push": "node tests/push.test.js",
        "test:streak": "node tests/streak.test.js",
        "test:account": "node tests/accountFlows.test.js",
        "test:pages": "node tests/pages.test.js",
        "test:jest": "jest",
        "test:integration": "jest --testPathPattern=tests/integration",
        "db:init": "node scripts/initDb.js",
        "db:reset": "node scripts/resetDb.js",
        "db:cleanup": "node scripts/cleanupDb.js",
        "db:migrate": "node scripts/migration_phase0.js",
        "test:elo": "node tests/eloService.test.js",
        "db:dump": "node scripts/dumpDb.js",
        "icons": "node scripts/makeIcons.js",
        "share-image": "node scripts/makeShareImage.js",
        "test:db": "node tests/ratedGame.test.js && node tests/ratedOnline.test.js && node tests/profile.test.js && node tests/emailAccount.test.js && node tests/lobby.test.js && node tests/matchmaking.test.js",
        "test:rated": "node tests/ratedGame.test.js",
        "test:online-rated": "node tests/ratedOnline.test.js",
        "test:profile": "node tests/profile.test.js",
        "test:mail": "node tests/emailAccount.test.js",
        "test:lobby": "node tests/lobby.test.js",
        "test:match": "node tests/matchmaking.test.js",
        "pages": "node scripts/makePages.js"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "nodemailer": "^10.1.2",
        "pg": "^8.11.3",
        "socket.io": "^4.8.1",
        "uuid": "^11.1.1",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "sharp": "^0.35.3",
        "socket.io-client": "^4.8.3",
        "supertest": "^6.3.3"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "keywords": [
        "hexaequo",
        "game",
        "api",
        "backend"
    ],
    "license": "MIT"
}
