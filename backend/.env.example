# Hexaequo Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/hexaequo

# The suites that write rows (npm run test:db) run only against a database of
# their own, named here. Never the one above if it holds real accounts.
# TEST_DATABASE_URL=postgresql://localhost:5432/hexaequo_test

# JWT
# In production this MUST be set to a real random secret — the server refuses to
# start otherwise. Anyone with this value can forge a token for any account, so
# it must never be the placeholder below. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin SQL console (routes/adminRoutes.js). Off unless ENABLE_ADMIN=1. When on,
# DEBUG_PASSWORD must be set to a real value (no default) or the server refuses
# to start. Turn it on only while you need it, and off again after.
ENABLE_ADMIN=0
DEBUG_PASSWORD=

# Set DEBUG_HTTP=1 to log every incoming request (off by default — otherwise the
# logs fill with vulnerability scanners probing for PHP files that do not exist).
DEBUG_HTTP=0

# Password hashing
BCRYPT_ROUNDS=10

# Email. Resend's API is tried first, then SMTP; with neither, no mail is sent
# and the server says so. EMAIL_FROM has to be on a domain the provider may send
# for. EMAIL_REPLY_TO is where a reply goes; empty, it goes back to EMAIL_FROM.
RESEND_API_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM=Hexaequo <noreply@hexaequo.com>
EMAIL_REPLY_TO=

# Push notifications: off unless both VAPID keys are set. Make the pair once, in
# backend/, and never change it — a new pair silently cuts off every device that
# has subscribed:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://hexaequo.com
# Reminders go out from production only. PUSH_REMINDERS=1 sends them from this
# machine too, so leave it at 0 on one whose DATABASE_URL is the live database.
PUSH_REMINDERS=0

# Frontend URL, for CORS and the links in mail. The backend serves the app
# itself, so on a development machine it is the backend's own address.
FRONTEND_URL=http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# The rating constants (starting Elo, the weight of each cadence) are in
# services/eloService.js, not here.
