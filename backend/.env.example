# Hexaequo Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/hexaequo

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing
BCRYPT_ROUNDS=10

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM=Hexaequo <noreply@hexaequo.com>

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5500

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# ELO CONFIGURATION (Phase 0)
# ============================================
DEFAULT_ELO=1000
ELO_MULTIPLIER_NONE=0
ELO_MULTIPLIER_BULLET=0.75
ELO_MULTIPLIER_BLITZ=0.9
ELO_MULTIPLIER_RAPID=1.0
ELO_MULTIPLIER_CLASSIC=1.2

# ============================================
# MATCHMAKING (Phase 2 - Future)
# ============================================
MATCHMAKING_QUEUE_EXPIRATION=300
MATCHMAKING_POLL_INTERVAL=2000

# ============================================
# INVITATIONS (Phase 2 - Future)
# ============================================
INVITATION_EXPIRATION=86400
INVITATION_CODE_LENGTH=8

# ============================================
# CHAT (Phase 3 - Future)
# ============================================
CHAT_MAX_MESSAGE_LENGTH=200
CHAT_RATE_LIMIT=10
