{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hexaequo-frontend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["serve.py"],
      "port": 8001
    },
    {
      "name": "hexaequo-web",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "web"],
      "port": 8765
    },
    {
      "name": "hexaequo-backend-nodb",
      "runtimeExecutable": "node-portable/node.exe",
      "runtimeArgs": ["backend/scripts/devNoDatabase.js"],
      "port": 3001
    }
  ]
}
